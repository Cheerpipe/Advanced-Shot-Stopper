# ESP-IDF build tree (generated). sdkconfig.defaults* and dependencies.lock
# are committed for reproducible Component Manager resolution.
build/
managed_components/
sdkconfig
sdkconfig.old
# Vendored trees stay local, except components the build requires: the
# esp-modbus stub is part of Component Manager resolution and must be
# committed like sdkconfig.defaults* and dependencies.lock.
third_party/*
!third_party/esp-modbus/

#!/usr/bin/env bash
# Open the ESP-IDF serial monitor.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Usage: ./scripts/monitor-idf [flags]

Start the ESP-IDF serial monitor. With --hardware and --machine, use that
variant's ELF to decode backtraces.
Exit: Ctrl+].

Required parameters: --port and --speed.

$(ss_flag_help)

Examples:
  ./scripts/monitor-idf --port /dev/cu.usbmodem2101 --speed 115200
  ./scripts/monitor-idf -p /dev/cu.usbmodem2101 -s 115200 \
    --hardware esp32-s3-relay-x1-speaker --machine rancilio-silvia-pro-x
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "port speed" || exit $?
if ss_is_set hardware_config || ss_is_set machine_config; then
  if ! ss_is_set hardware_config || ! ss_is_set machine_config; then
    echo "--hardware and --machine must be used together." >&2
    exit 2
  fi
  ss_cli_resolve_profiles "" check || exit $?
fi
SS_IDF_QUIET=1
ss_idf_source

port="$(ss_get port)"
speed="$(ss_get speed)"

# Persist before exec: the monitor runs until the user stops it.
ss_cli_save

echo "Serial monitor on $port ($speed)"
if ss_is_set arch; then
  shotstopper_resolve_board "$(ss_get arch)" || exit 2
  ss_idf_py_args
  exec idf.py "${IDF_PY_ARGS[@]}" -p "$port" -b "$speed" monitor
fi
exec python "$IDF_PATH/tools/idf_monitor.py" -p "$port" -b "$speed"

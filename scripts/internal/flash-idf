#!/usr/bin/env bash
# Flash an already compiled ESP-IDF image over USB.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Internal flash stage. Use: ./scripts/dev flash [monitor] --confirm [flags]

Flash an ESP-IDF firmware binary over USB. Without --image, uses the
already-built binary for the selected profile pair; it never rebuilds or
changes that image. Use ./scripts/dev build --webui-language <code> first to select the
WebUI language. With --no-check, existing outputs are flashed without identity
verification. Does not open the monitor. This is the official USB flash path.

Required parameters: --port plus either both profiles or --arch for a legacy
existing image. New builds always use profiles.

$(ss_flag_help)

$(shotstopper_arch_help)

Examples through the public facade:
  ./scripts/dev flash --confirm --port /dev/cu.usbmodem2101 \
    --hardware esp32-s3-relay-x1-speaker --machine rancilio-silvia-pro-x
  ./scripts/dev flash --confirm --port /dev/cu.usbmodem2101 \
    --hardware esp32-s3-relay-x1-speaker --machine la-marzocco-linea-micra \
    --erase-all
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

if ss_is_set webui_language; then
  echo '--webui-language is build-only; run ./scripts/dev build with it before flashing.' >&2
  exit 2
fi

if [[ "$SS_CLI_ERASE_ALL" == "1" ]] && ss_is_set image; then
  echo '--erase-all cannot be combined with --image.' >&2
  echo 'A blank chip needs the project bootloader, partition table, otadata, and application.' >&2
  exit 2
fi

ss_cli_apply_env
if ss_is_set hardware_config || ss_is_set machine_config; then
  if ! ss_is_set hardware_config || ! ss_is_set machine_config; then
    echo "--hardware and --machine must be used together." >&2
    exit 2
  fi
  ss_cli_resolve "port hardware_config machine_config" || exit $?
  ss_cli_resolve_profiles "" check || exit $?
else
  ss_cli_resolve "port arch" || exit $?
fi
ss_cli_normalize_image || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_source
ss_idf_py_args

cd "$SS_CLI_ROOT"

image="$IDF_IMAGE"
if ss_is_set image; then
  image="$(ss_get image)"
else
  ss_idf_require_image
fi

if [[ "$SS_CLI_NO_CHECK" == "1" ]]; then
  echo "Skipping local image verification (--no-check)."
else
  command -v node >/dev/null 2>&1 || {
    echo "node not found on PATH (needed to verify the firmware image)." >&2
    exit 127
  }
  echo "Local image identity:"
  identity_args=(--expect-arch "$SHOTSTOPPER_ARCH")
  if [[ -n "${SHOTSTOPPER_HARDWARE_COMPAT:-}" ]]; then
    identity_args+=(--expect-hardware "$SHOTSTOPPER_HARDWARE_COMPAT"
      --expect-machine "$SHOTSTOPPER_MACHINE_COMPAT")
  fi
  node ./scripts/image_tag.js "$image" "${identity_args[@]}"
fi

port="$(ss_get port)"
echo "Flashing $image ($SHOTSTOPPER_ARCH) via $port (IDF)"

command -v esptool >/dev/null 2>&1 || {
  echo "esptool not found on PATH (did ESP-IDF export.sh run?)." >&2
  exit 127
}

partition_bin="$(mktemp "${TMPDIR:-/tmp}/shotstopper-partition.XXXXXX")"
partition_csv="$(mktemp "${TMPDIR:-/tmp}/shotstopper-partition-csv.XXXXXX")"
cleanup_partition_probe() {
  rm -f "$partition_bin" "$partition_csv"
}
trap cleanup_partition_probe EXIT HUP INT TERM

curve_layout_transition=0
installed_layout=unknown
installed_nvs_size=""
installed_app0_offset=""
installed_shotcurve_row=""
if esptool --chip esp32s3 --port "$port" read-flash 0x8000 0x1000 "$partition_bin" >/dev/null; then
  if python -c 'import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); sys.exit(0 if b and all(x == 255 for x in b) else 1)' "$partition_bin"; then
    installed_layout=blank
  elif python "$IDF_PATH/components/partition_table/gen_esp32part.py" --quiet \
    "$partition_bin" "$partition_csv" >/dev/null 2>&1; then
    installed_layout=present
    installed_nvs_size="$(awk -F, '$1 ~ /^[[:space:]]*nvs[[:space:]]*$/ {gsub(/[[:space:]]/, ""); print $5; exit}' "$partition_csv")"
    installed_app0_offset="$(awk -F, '$1 ~ /^[[:space:]]*app0[[:space:]]*$/ {gsub(/[[:space:]]/, ""); print $4; exit}' "$partition_csv")"
    installed_shotcurve_row="$(awk -F, '$1 ~ /^[[:space:]]*shotcurve[[:space:]]*$/ {gsub(/[[:space:]]/, ""); print $2 "," $3 "," $4 "," $5; exit}' "$partition_csv")"
  fi
fi

size_bytes() {
  case "$1" in
  *K) printf '%s' "$((${1%K} * 1024))" ;;
  *M) printf '%s' "$((${1%M} * 1024 * 1024))" ;;
  0x* | [0-9]*) printf '%s' "$(($1))" ;;
  *) return 1 ;;
  esac
}

if [[ "$SS_CLI_ERASE_ALL" != "1" && "$installed_layout" == "present" ]]; then
  installed_nvs_bytes="$(size_bytes "$installed_nvs_size")" || {
    echo 'Could not read the installed NVS partition size.' >&2
    exit 1
  }
  if ((installed_nvs_bytes != 0x15000)); then
    printf 'Installed NVS is %s bytes; this firmware requires 86016 bytes.\n' \
      "$installed_nvs_bytes" >&2
    echo 'Re-run with --erase-all: the partition layout changed, so an in-place flash is not possible. This destroys all saved data.' >&2
    exit 1
  fi
  IFS=, read -r installed_shotcurve_type installed_shotcurve_subtype \
    installed_shotcurve_offset installed_shotcurve_size <<<"$installed_shotcurve_row"
  required_shotcurve_offset=0x69E000
  [[ "$SHOTSTOPPER_ARCH" == "n16r8" ]] && required_shotcurve_offset=0x63E000
  if [[ "$installed_shotcurve_type" != "data" ]] ||
    ! installed_shotcurve_subtype_bytes="$(size_bytes "$installed_shotcurve_subtype")" ||
    ! installed_shotcurve_offset_bytes="$(size_bytes "$installed_shotcurve_offset")" ||
    ! installed_shotcurve_size_bytes="$(size_bytes "$installed_shotcurve_size")" ||
    ((installed_shotcurve_subtype_bytes != 0x40 || \
    installed_shotcurve_offset_bytes != required_shotcurve_offset || \
    installed_shotcurve_size_bytes != 0xCC000)); then
    # Only the project's exact previous layout has an in-place transition.
    # All durable unrelated partitions and both app slots keep their addresses.
    if ! ss_is_set image && python - "$partition_csv" "$SHOTSTOPPER_ARCH" <<'PY'
import csv, sys
def number(value):
    value = value.strip()
    return int(value[:-1], 0) * {'K': 1024, 'M': 1048576}[value[-1]] if value[-1:] in ('K', 'M') else int(value, 0)
rows = {}
with open(sys.argv[1]) as source:
    for row in csv.reader(line for line in source if not line.startswith('#')):
        if row:
            rows[row[0].strip()] = (row[1].strip(), row[2].strip(), number(row[3]), number(row[4]))
large = sys.argv[2] == 'n16r8'
start = 0x620000 if large else 0x680000
expected = {
    'nvs': ('data', 'nvs', 0x9000, 0x15000),
    'otadata': ('data', 'ota', 0x1e000, 0x2000),
    'app0': ('app', 'ota_0', 0x20000, 0x300000 if large else 0x330000),
    'app1': ('app', 'ota_1', 0x320000 if large else 0x350000, 0x300000 if large else 0x330000),
    'shotcurve': ('data', '64', start, 0xe000),
    'shotlog': ('data', '64', start + 0xe000, 0x8000),
    'history': ('data', '64', start + 0x16000, 0x8000),
}
expected['ffat' if large else 'spiffs'] = ('data', 'fat' if large else 'spiffs', start + 0x1e000, 0x7c2000 if large else 0x152000)
expected['coredump'] = ('data', 'coredump', 0xe00000 if large else 0x7f0000, 0xa0000 if large else 0x10000)
if large:
    expected['crashhist'] = ('data', '64', 0xea0000, 0x160000)
for name in ('shotcurve', 'shotlog', 'history', 'crashhist'):
    if name in rows and rows[name][1] == '0x40':
        rows[name] = (rows[name][0], '64', *rows[name][2:])
sys.exit(0 if rows == expected else 1)
PY
    then
      curve_layout_transition=1
      echo 'USB curve-layout transition: previous shot curves start empty; settings, Wi-Fi, calibration, presets, shot summaries and activation history are preserved.'
      echo 'Both OTA slots and crash storage are preserved; OTA updates continue after this one-time USB installation.'
    else
      printf 'Installed layout lacks the required %s shotcurve partition (data/0x40 at 0x%X, size 835584).\n' \
        "$SHOTSTOPPER_ARCH" "$required_shotcurve_offset" >&2
      echo 'Only the exact previous project layout supports the preserving USB transition. An external app image cannot change partitions.' >&2
      echo 'Use --erase-all only if you explicitly intend to destroy all saved data.' >&2
      exit 1
    fi
  fi
fi

if [[ "$SS_CLI_ERASE_ALL" == "1" ]]; then
  echo 'Erasing the complete flash: firmware, settings, Wi-Fi, calibration, and history.'
  esptool --chip esp32s3 --port "$port" erase-flash
elif [[ "$installed_layout" == "unknown" ]]; then
  echo 'Could not verify the installed partition layout.' >&2
  exit 1
fi

if ss_is_set image; then
  # An external application image replaces app0 only. Bootloader and partition
  # table remain in place, so the selected image must match this architecture.
  if [[ "$installed_layout" != "present" || -z "$installed_app0_offset" ]]; then
    echo 'An external image requires a readable installed partition table.' >&2
    exit 1
  fi
  esptool --chip esp32s3 --port "$port" write-flash \
    "$installed_app0_offset" "$image"
else
  # Flash the already-built project outputs directly. `idf.py flash` would
  # re-run the build target and could silently regenerate a different WebUI.
  if [[ ! -f "$IDF_BUILD_DIR/flash_args" ]]; then
    echo "$IDF_BUILD_DIR/flash_args does not exist." >&2
    echo "Build first with --hardware and --machine, or provide --image." >&2
    exit 1
  fi
  # flash_args lists bootloader, partition table, otadata and app at their
  # offsets with relative paths, so esptool must run from the build directory.
  (
    cd "$IDF_BUILD_DIR" || exit 1
    if [[ "$curve_layout_transition" == "1" ]]; then
      esptool --chip esp32s3 --port "$port" erase-region "$required_shotcurve_offset" 0xCC000
    fi
    esptool --chip esp32s3 --port "$port" write-flash @flash_args
  )
fi

ss_cli_save

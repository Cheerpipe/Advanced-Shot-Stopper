#!/usr/bin/env bash
# Update ESP-IDF controller firmware over Wi-Fi, without a USB cable.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"
# shellcheck source=scripts/shotstopper_ota.sh
source "$SCRIPT_DIR/shotstopper_ota.sh"

usage() {
  cat <<EOF
Internal OTA stage. Use: ./scripts/dev ota [monitor] --confirm [flags]

Upload the already-built ESP-IDF image to the controller, verify it, and leave
it ready to boot.

Required parameters: --host plus either both profiles or --arch for a legacy
existing image. New builds always use profiles. Supply the device password
through the hidden prompt, SHOTSTOPPER_DEVICE_PASSWORD, or --password-stdin.

$(ss_flag_help)

$(shotstopper_arch_help)

Example through the public facade:
  ./scripts/dev ota --confirm --hardware esp32-s3-relay-x1-speaker \
    --machine rancilio-silvia-pro-x --host 192.168.1.50 \
    --yes --wait-for-confirmation

Without --image, the image comes from the selected profile pair's build folder.
Use ./scripts/dev build ota to build and upload in one command.

Use --yes to commit without asking. Use --wait-for-confirmation independently
to wait until the rebooted firmware confirms itself through its HTTP API.

Resumable OTA rejects --no-check because SHA-256, architecture, hardware
profile, machine profile, and version are required to safely resume one image.

Use --discard-ota-session to explicitly discard a partial or staged different
image before creating the requested session. Matching images resume
automatically and do not need this flag.
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi
if [[ "$SS_CLI_YES" != "1" ]] && ! ss_can_prompt; then
  echo 'Non-interactive OTA requires --yes before any transfer is started.' >&2
  exit 2
fi

ss_cli_apply_env
if ss_is_set hardware_config || ss_is_set machine_config; then
  if ! ss_is_set hardware_config || ! ss_is_set machine_config; then
    echo "--hardware and --machine must be used together." >&2
    exit 2
  fi
  ss_cli_resolve "hardware_config machine_config host password" || exit $?
  ss_cli_resolve_profiles "" check || exit $?
else
  ss_cli_resolve "arch host password" || exit $?
fi
ss_cli_normalize_image || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_resolve_paths

root="$SS_CLI_ROOT"
cd "$root"

image="$IDF_IMAGE"
if ss_is_set image; then
  image="$(ss_get image)"
else
  ss_idf_require_image
fi

command -v node >/dev/null 2>&1 || {
  echo "node not found on PATH (needed to verify the firmware image)." >&2
  exit 127
}
identity_args=(--expect-arch "$SHOTSTOPPER_ARCH")
if [[ -n "${SHOTSTOPPER_HARDWARE_COMPAT:-}" ]]; then
  identity_args+=(--expect-hardware "$SHOTSTOPPER_HARDWARE_COMPAT"
                  --expect-machine "$SHOTSTOPPER_MACHINE_COMPAT")
fi
node ./scripts/image_tag.js "$image" "${identity_args[@]}" >/dev/null

trap ss_ota_cleanup EXIT
ss_ota_run "$image" "$SHOTSTOPPER_ARCH" "$(ss_get host)" \
  "$(ss_get password)" "$SS_CLI_YES" "$SS_CLI_WAIT_FOR_CONFIRMATION" \
  "$SS_CLI_NO_CHECK" "$SS_CLI_DISCARD_OTA_SESSION" || exit $?
ss_cli_save

#!/usr/bin/env bash
# Compile Shot Stopper with ESP-IDF (Arduino-ESP32 as a component) into
# build-idf/<hardware>--<machine>. This is the official supported firmware build.
set -euo pipefail

INTERNAL_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_DIR="$(CDPATH='' cd -- "$INTERNAL_DIR/.." && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Internal build stage. Use: ./scripts/dev build [flash|ota] [monitor] [flags]

Compile Shot Stopper with ESP-IDF (official supported path) and write artifacts
to build-idf/<hardware>--<machine>.

Required parameters: --hardware and --machine. --flags is optional.
The WebUI language defaults to en and is selected at compile time.

$(ss_flag_help)

$(shotstopper_arch_help)

Firmware optimization level (build-only, exclusive, not persisted):
  --o0 -O0 debug without optimization; --og -Og IDF debug default;
  --o2 -O2 performance; --os -Os size (repository default and the
  qualified profile); -O1 and -O3 are not ESP-IDF Kconfig levels and are rejected.
  The level is a Kconfig choice: the build reconfigures when it changes and
  the verifier checks the selected level. mbedTLS keeps its own level.

Recommended development compile flags (Enter at the prompt):
  $SS_CLI_DEFAULT_FLAGS

Requires ESP-IDF 6.1.x. If IDF_PATH is unset, ${IDF_DEFAULT_HOME} is used when
it exists.

BLE backend:
  Native ESP-IDF NimBLE (only production backend).

Examples through the public facade:
  ./scripts/dev build --hardware esp32-s3-relay-x1-speaker \
    --machine rancilio-silvia-pro-x
  ./scripts/dev build --hardware esp32-s3-relay-x1-speaker \
    --machine la-marzocco-linea-micra --webui-language EN
  ./scripts/dev build --hardware esp32-s3-relay-x1-speaker-reed \
    --machine rancilio-silvia-pro-x-reed --development
EOF
}

if [[ "${SS_BUILD_LOCKED:-}" != "1" ]]; then
  ss_cli_parse "$@" || exit $?
  if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
    usage
    exit 0
  fi

  ss_cli_resolve "hardware_config machine_config webui_language" "flags" || exit $?
  effective_flags="$(ss_cli_effective_flags)" || exit $?

  root="$SS_CLI_ROOT"
  cd "$root"
  ss_cli_resolve_profiles "$effective_flags" || exit $?
  printf '%s\n' "$SS_PROFILE_OUTPUT"

  # Serialize per-variant builds across parallel agents and sessions: the
  # variant tree (generated headers, sdkconfig, artifacts) is mutated by the
  # whole remainder of this script. Prompted input happened above, so no
  # interactive pause holds the lock. The shell state crosses the exec via a
  # declare -p dump (arrays survive; export would flatten them); with-flock
  # holds the lock and execs the second pass, so the kernel releases it on
  # every exit path including signals.
  SS_BUILD_STATE_FILE="$(mktemp "${TMPDIR:-/tmp}/ss-build-state.XXXXXX")"
  state_vars="$(compgen -A variable 2>/dev/null | grep -E '^(SS_|SHOTSTOPPER_)' || true)"
  # shellcheck disable=SC2086  # names list is meant to word-split
  { [[ -z "$state_vars" ]] || declare -p $state_vars 2>/dev/null; } \
    >"$SS_BUILD_STATE_FILE" || true
  mkdir -p "$SS_CLI_ROOT/build-idf/.locks"
  SS_BUILD_LOCKED=1 SS_BUILD_STATE_FILE="$SS_BUILD_STATE_FILE" \
    exec python3 "$SCRIPT_DIR/internal/with-flock" \
    "$SS_CLI_ROOT/build-idf/.locks/$SHOTSTOPPER_VARIANT.lock" \
    bash "$SCRIPT_DIR/internal/${0##*/}"
fi

eval "$(cat "$SS_BUILD_STATE_FILE")"
rm -f "$SS_BUILD_STATE_FILE"
root="$SS_CLI_ROOT"
cd "$root"
effective_flags="$(ss_cli_effective_flags)" || exit $?

shotstopper_resolve_board "$(ss_get arch)"
ss_idf_source

# Map the exclusive CLI level flags to their ESP-IDF Kconfig choices. Empty
# keeps the repository default (-Os / SIZE). ss_idf_py_args registers the
# generated overlay as the last SDKCONFIG_DEFAULTS entry so the chosen level
# wins over every earlier default file.
case "${SS_CLI_OPT_LEVEL:-}" in
  --o0) SS_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_NONE ;;
  --og) SS_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_DEBUG ;;
  --o2) SS_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_PERF ;;
  --os) SS_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_SIZE ;;
  *)    SS_IDF_OPT_LEVEL_KCONFIG=CONFIG_COMPILER_OPTIMIZATION_SIZE ;;
esac
export SS_IDF_OPT_LEVEL_KCONFIG

ss_idf_py_args

command -v node >/dev/null 2>&1 || {
  echo "node not found on PATH (needed for the Web UI and OTA marker)." >&2
  exit 127
}

echo "Building ${SHOTSTOPPER_VARIANT:-$SHOTSTOPPER_ARCH} (IDF, BLE=nimble, allocator=external)"

export SHOT_STOPPER_EXTRA_FLAGS
SHOT_STOPPER_EXTRA_FLAGS="$effective_flags"
echo "Extra compile flags: ${SHOT_STOPPER_EXTRA_FLAGS:-(none)}"

mkdir -p "$IDF_BUILD_DIR"
# Spike sdkconfig / CMake cache predates Arduino autostart and the firmware
# project name. Reuse would keep ALLOW_BSS but skip AUTOSTART and g_probe checks.
# Also rebuild when Shot Stopper Kconfig keys are missing from an older tree,
# when IPv6 was disabled (breaks arduino-esp32 → esp-modbus), when the log
# ceiling predates runtime-selectable INFO/DEBUG application logging, or when
# the sdkconfig predates the mDNS responder or Wi-Fi TX-pool budgets (defaults
# only seed a fresh sdkconfig, so resource changes need a regeneration).
if [[ -f "$IDF_BUILD_DIR/shotstopper_idf_spike.elf" ]] ||
   { [[ -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] && grep -q 'shotstopper_idf_spike' "$IDF_BUILD_DIR/CMakeCache.txt"; } ||
   { [[ -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] && ! grep -Fq "CMAKE_TOOLCHAIN_FILE:FILEPATH=${IDF_PATH}/tools/cmake/" "$IDF_BUILD_DIR/CMakeCache.txt"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_AUTOSTART_ARDUINO=y$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_SHOT_STOPPER_ENABLE_BUZZER=' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_LWIP_IPV6=y$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_MDNS_MAX_INTERFACES=2$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_LWIP_MAX_SOCKETS=10$' "$IDF_SDKCONFIG"; }; then
  echo "Cleaning stale IDF build tree"
  rm -rf "$IDF_BUILD_DIR"
  mkdir -p "$IDF_BUILD_DIR"
fi

echo "Building IDF firmware $SHOTSTOPPER_ARCH → $IDF_BUILD_DIR"
ss_idf_py_args
ss_idf_sync_extra_flags
ss_idf_sync_jtag_console
ss_idf_sync_nimble_config
ss_idf_sync_micra_tls
ss_idf_emit_opt_overlay

if [[ ! -f "$IDF_SDKCONFIG" ]] ||
   ! grep -q '^CONFIG_IDF_TARGET="esp32s3"$' "$IDF_SDKCONFIG"; then
  ss_idf_prepare_set_target
  idf.py "${IDF_PY_ARGS[@]}" set-target esp32s3
fi

# set-target performs fullclean and removes generated files from a fresh
# variant tree. Re-emit the validated profile after it completes and before
# any translation unit is compiled.
python3 ./scripts/resolve_build_profiles.py \
  --hardware "$(ss_get hardware_config)" \
  --machine "$(ss_get machine_config)" \
  --flags="$effective_flags" --output-root "$root/build-idf" >/dev/null

# Re-emit the optimization overlay after set-target (fullclean removes
# generated files from a fresh variant tree), then recreate the configuration
# when an existing sdkconfig holds a different level.
ss_idf_emit_opt_overlay
ss_idf_sync_opt_level

./scripts/gen_version.sh "$SHOTSTOPPER_ARCH" \
  "$SHOTSTOPPER_HARDWARE_COMPAT" "$SHOTSTOPPER_MACHINE_COMPAT" \
  "$SHOTSTOPPER_GENERATED_DIR/ShotStopperVersion.h"

# Generate the Web UI after the firmware identity header so the baked cache
# version equals the reported firmware version; the UI compares them to reload
# a stale cached shell exactly once after an update.
echo "WebUI language: $(ss_get webui_language)"
# Bake the shell body class in development builds so the dev UI never paints
# the lock panel or the timed UI Override section.
webui_dev_flag=''
grep -q -- '-DSHOT_STOPPER_DEVELOPMENT=1' <<<"$effective_flags" && webui_dev_flag='--development'
# Bake only the UI of the compiled machine type into the served Web UI.
webui_type_flag=''
webui_machine_type="$(sed -n 's/^#define SHOT_STOPPER_MACHINE_TYPE //p' \
  "$SHOTSTOPPER_GENERATED_DIR/ShotStopperBuildProfileGenerated.h" 2>/dev/null)"
case "$webui_machine_type" in
  0) webui_type_flag='--machine-type paddle' ;;
  1) webui_type_flag='--machine-type momentary' ;;
  2) webui_type_flag='--machine-type momentary_reed' ;;
  *) echo "warning: unknown machine type '${webui_machine_type}'; generating type-agnostic Web UI" >&2 ;;
esac
# Remote control builds embed the fixed Home action bar; without the flag the
# panel markup and CSS are omitted so a disabled feature costs no UI bytes.
webui_remote_flag=''
grep -q -- '-DSHOT_STOPPER_ENABLE_REMOTE_MACHINE_CONTROL=1' <<<"$effective_flags" \
  || webui_remote_flag='--no-remote-control'
# shellcheck disable=SC2086  # flags hold zero or one complete token
node ./scripts/gen_web_ui.js --webui-language "$(ss_get webui_language)" $webui_dev_flag $webui_type_flag $webui_remote_flag

ss_idf_commit_extra_flags_stamp

idf.py "${IDF_PY_ARGS[@]}" build 2>&1 | ss_idf_filter_output

python -m esp_idf_size --format json2 -o "$IDF_BUILD_DIR/size.json" \
  "$IDF_BUILD_DIR/shotstopper.map"
node "$root/src/tests/check_firmware_size.js" "$IDF_BUILD_DIR/shotstopper.bin" \
  --arch "$SHOTSTOPPER_ARCH"

ss_idf_verify_firmware
if [[ -n "${SHOTSTOPPER_VARIANT:-}" ]]; then
  artifact="$IDF_BUILD_DIR/shotstopper-${SHOTSTOPPER_VARIANT}.bin"
  cp "$IDF_IMAGE" "$artifact"
  echo "Named firmware artifact: $artifact"
fi
ss_cli_save

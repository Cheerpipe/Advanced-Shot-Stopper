#!/usr/bin/env bash
# Build the firmware with GCC's interprocedural static analyzer enabled.
set -uo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

readonly ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
readonly OUTPUT_DIR="reports/gcc-analyzer"

usage() {
  cat <<EOF
Usage: ./scripts/gcc_analyzer [flags]

Build Shot Stopper with GCC -fanalyzer and save the filtered result to
reports/gcc-analyzer/gcc-analyzer.txt. Replaces the previous report.
The full compile log is kept in gcc-analyzer-raw.txt; the main report keeps
only diagnostics whose primary location is versioned code in this repository.

Required parameters: --hardware and --machine. --flags is optional and appended
to the analysis.

$(ss_flag_help)

$(shotstopper_arch_help)

Examples:
  ./scripts/gcc_analyzer --hardware esp32-s3-relay-x1-speaker \
    --machine rancilio-silvia-pro-x
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "hardware_config machine_config webui_language" "flags" || exit $?

cd "$ROOT"
output_path="$ROOT/$OUTPUT_DIR"
rm -rf "$output_path"
mkdir -p "$output_path"

# -fanalyzer is a tool flag, not a user preference: passing it through
# ./scripts/build-idf would persist it into .shotstopper and every later compile.
# A failed/interrupted legacy analyzer run may have left -fanalyzer in the
# persisted flags. Strip every copy before building and saving so this tool
# never leaks its analysis-only option into ordinary builds.
configured_flags="$(ss_get flags)"
user_flags=""
for configured_flag in $configured_flags; do
  case "$configured_flag" in
    -fanalyzer) ;;
    *) user_flags="${user_flags:+$user_flags }$configured_flag" ;;
  esac
done
ss_put flags "$user_flags" cli
effective_flags="$(ss_cli_effective_flags)" || exit $?
analyzer_flags="${effective_flags:+$effective_flags }-fanalyzer"
ss_cli_resolve_profiles "$analyzer_flags" || exit $?
shotstopper_resolve_board "$(ss_get arch)" || exit 2
echo "Running GCC -fanalyzer for $SHOTSTOPPER_ARCH..."

raw_report="$output_path/gcc-analyzer-raw.txt"
report="$output_path/gcc-analyzer.txt"

SHOTSTOPPER_NONINTERACTIVE=1 ./scripts/build-idf \
  --hardware "$(ss_get hardware_config)" --machine "$(ss_get machine_config)" \
  --webui-language "$(ss_get webui_language)" \
  --flags "$analyzer_flags" >"$raw_report" 2>&1
build_status=$?

ss_cli_save

if [[ $build_status -ne 0 ]]; then
  cat "$raw_report" >&2
  printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
    "$SHOTSTOPPER_ARCH" "$build_status" > "$output_path/README.txt"
  echo "Build failed; log saved under $OUTPUT_DIR/gcc-analyzer-raw.txt" >&2
  exit "$build_status"
fi

# GCC also analyzes ESP-IDF and managed components. Keep each warning block
# only when its primary location is in a project-owned source tree; associated
# traces are retained so the diagnostic remains useful.
awk -v shotstopper="$ROOT/src/" \
    -v espresso_scale_ble="$ROOT/libraries/EspressoScaleBLE/" \
    -v idf_main="$ROOT/idf/main/" \
    -v idf_components="$ROOT/idf/components/" '
  /^[^:]+:[0-9]+:[0-9]+: (warning|error):/ {
    if ($0 ~ /\[-Wanalyzer-/) {
      keep = index($0, shotstopper) == 1 || \
             index($0, espresso_scale_ble) == 1 || \
             index($0, idf_main) == 1 || \
             index($0, idf_components) == 1
      if (keep) print
      next
    }
    keep = 0
  }
  keep { print }
' "$raw_report" > "$report"

analyzer_status=0

if grep -q '\[-Wanalyzer-' "$report"; then
  analyzer_status=1
fi

printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
  "$SHOTSTOPPER_ARCH" "$analyzer_status" > "$output_path/README.txt"

echo "Report saved under $OUTPUT_DIR/"
exit "$analyzer_status"

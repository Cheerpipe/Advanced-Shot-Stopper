#!/usr/bin/env bash
# Build, flash, and monitor Shot Stopper (ESP-IDF) in one command.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

usage() {
  cat <<EOF
Usage: ./scripts/bfm-idf [flags]

Runs, in order: build-idf, flash-idf, and monitor-idf. The flash step skips the
local image re-check and transfers the output that build-idf just produced.

Required parameters: --port, --hardware, --machine, and --speed. --flags is optional.

$(ss_flag_help)

Examples:
  ./scripts/bfm-idf --port /dev/cu.usbmodem2101 --speed 115200 \
    --hardware esp32-s3-relay-x1-speaker --machine rancilio-silvia-pro-x
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "port hardware_config machine_config speed webui_language" "flags" || exit $?
ss_cli_normalize_image || exit $?

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

ss_cli_flags_for hardware_config machine_config flags webui_language development
./scripts/build-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}

ss_cli_flags_for port hardware_config machine_config image no_check erase_all
./scripts/flash-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}

ss_cli_flags_for port speed hardware_config machine_config
exec ./scripts/monitor-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}

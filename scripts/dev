#!/usr/bin/env python3
"""Canonical, non-bootstrapping developer command facade."""

from __future__ import annotations

import datetime as dt
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parent.parent
# ANSI status colors: honor NO_COLOR and only tint real terminals.
COLOR_ENABLED = (os.getenv("NO_COLOR") is None and
                 os.getenv("TERM") != "dumb" and sys.stdout.isatty())

def paint(text: str, code: str) -> str:
    """Wrap text in an ANSI escape if colors are on, else return it bare."""
    return f"\x1b[{code}m{text}\x1b[0m" if COLOR_ENABLED else text


def painted(text: str) -> str:
    """Tint a line by meaning: error red, warning yellow, success green,
    neutral header cyan."""
    head = text[:30].lower()
    if head.startswith(("error", "failed", "missing_dependency", "dev:")) or \
            ": missing" in head or "error:" in head:
        return paint(text, "31")
    if "warning" in head:
        return paint(text, "33")
    if head.startswith("passed"):
        return paint(text, "32")
    if head.startswith(("==>", "risk=")):
        return paint(text, "36")
    return text


RANK = {f"R{i}": i for i in range(4)}
AREAS = {
    "safety": ("relay, boot, watchdog, and fail-open contracts", ["PROJECT_CHARTER.md", "src/ShotStopperSafety.h", "src/ShotStopperMachineRelay.h", "src/tests/safety_external_host_test.cpp", "docs/MANUAL_TEST_PLAN.md"]),
    "control": ("brew orchestration and guards", ["src/ShotStopperBrew.h", "src/ShotStopperDomain.h", "src/tests/shot_stopper_host_test.cpp", "docs/STATE_MACHINES.md"]),
    "machine": ("paddle, momentary inputs, and physical actuation", ["src/ShotStopperMachine.h", "src/ShotStopperMachineTypes.h", "src/tests/momentary_machine_host_test.cpp", "docs/HARDWARE.md"]),
    "scale": ("scale link, sensing, and worker ownership", ["src/ShotStopperScaleLink.h", "src/ShotStopperScaleSense.h", "src/ShotStopperScaleWorker.cpp", "docs/CONCURRENCY.md"]),
    "ble": ("scale protocols and BLE radio", ["libraries/EspressoScaleBLE/src", "libraries/EspressoScaleBLE/tests", "src/ShotStopperScaleWorker.cpp", "src/ShotStopperBleScanPersistence.h"]),
    "network": ("HTTP transport and outbound webhooks", ["src/ShotStopperNetwork.cpp", "src/ShotStopperWebhook.cpp", "src/tests/check_http_route_capacity.js", "src/tests/webhook_error_host_test.cpp", "docs/RESOURCE_OWNERSHIP.md"]),
    "ota": ("verified and resumable firmware update", ["src/ShotStopperOta.cpp", "src/ShotStopperOtaImage.h", "src/tests/run_ota_tests.sh", "docs/features/ota.md"]),
    "persistence": ("settings, logs, recovery, and migrations", ["src/ShotStopperPersistence.h", "src/ShotStopperDurableStores.h", "src/tests/persistence_host_test.cpp", "docs/ARCHITECTURE.md"]),
    "web": ("embedded browser UI and asset generation", ["src/web", "scripts/gen_web_ui.js", "src/tests/check_web_assets.js", "docs/SCREENSHOTS.md"]),
    "build": ("ESP-IDF integration, variants, and analysis", ["idf", "scripts/internal/build-idf", "scripts/check_architecture.py", "docs/BUILD.md"]),
    "tests": ("host, Web, OTA, and architecture tests", ["src/tests", "libraries/EspressoScaleBLE/tests", "CMakePresets.json", "VALIDATION.md"]),
}
SECRET = re.compile(r"(?i)(password|token)(\s*[=:]\s*|\s+)\S+")
HTTP_ROUTE_CAPACITY_STEP = (
    "http-route-capacity", ["node", "src/tests/check_http_route_capacity.js"])
BUILD_PROFILES = (
    ("esp32-s3-relay-x1-speaker", "la-marzocco-linea-micra"),
    ("esp32-s3-relay-x1-speaker", "rancilio-silvia-pro-x"),
    ("esp32-s3-relay-x1-speaker-reed", "rancilio-silvia-pro-x"),
)
FIRMWARE_BUDGET_OPTIONS = ["--flags=", "--development"]
FIRMWARE_STAGES = {"build", "flash", "ota", "monitor"}
FIRMWARE_PIPELINES = {
    ("build",), ("flash",), ("ota",), ("monitor",),
    ("build", "flash"), ("build", "ota"),
    ("flash", "monitor"), ("ota", "monitor"),
    ("build", "flash", "monitor"), ("build", "ota", "monitor"),
}


def redact(value: str) -> str:
    return SECRET.sub(lambda m: f"{m.group(1)}=[REDACTED]", value)


def sha() -> str:
    result = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                            text=True, capture_output=True)
    return result.stdout.strip() if result.returncode == 0 else "unknown"


def changed_paths() -> list[str]:
    tracked = subprocess.run(["git", "diff", "--name-only", "HEAD"], cwd=ROOT,
                             text=True, capture_output=True).stdout.splitlines()
    untracked = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard"], cwd=ROOT,
        text=True, capture_output=True).stdout.splitlines()
    return sorted(set(tracked + untracked))


def path_risk(path: str) -> str:
    p = path.replace("\\", "/")
    while p.startswith("./"):
        p = p[2:]
    name = Path(p).name.lower()
    if p.startswith("idf/partitions-") or re.search(
            r"(?i)(machine|relay|safety|watchdog|hardware|resetguard|recovery|resourceowner)", p):
        return "R3"
    if p.startswith(("libraries/EspressoScaleBLE/", "idf/")) or re.search(
            r"(?i)(ble|network|webhook|ota|persist|nvs|settingsmigrate|shotlog)", p):
        return "R2"
    if p.startswith(("src/web/", "src/tests/", "scripts/", ".github/")) or p in {
            "CMakeLists.txt", "CMakePresets.json", "package.json", "package-lock.json"}:
        return "R1"
    if p.endswith(".md") or name in {"agents.md", ".cursorignore", ".gitignore"} or p.startswith(".cursor/"):
        return "R0"
    return "R3"


def uncovered_changes(paths: list[str]) -> list[str]:
    """Changed working-tree paths not covered by an explicit path list.

    Several agents may share this checkout: a gate run on explicit paths
    silently excludes everyone else's edits. The warning keeps the gate's
    classification honest without blocking parallel work. Empty paths means
    the whole tree is in scope, so nothing can be missed.
    """
    normalized = sorted({
        re.sub(r"^\./+", "", p.replace("\\", "/")).rstrip("/")
        for p in paths
    })
    if not normalized or any(a in {"", "."} for a in normalized):
        return []
    return [p for p in changed_paths()
            if not any(p == a or p.startswith(a + "/") for a in normalized)]


def classify(paths: list[str]) -> tuple[str, list[tuple[str, str]]]:
    paths = paths or changed_paths()
    details = [(p, path_risk(p)) for p in paths]
    risk = max((r for _, r in details), key=RANK.get, default="R0")
    return risk, details


def markdown_prose(source: Path) -> str:
    """Keep line numbers while excluding fenced examples from link checks."""
    lines, fence = [], ""
    for line in source.read_text(errors="replace").splitlines(keepends=True):
        marker = re.match(r"^\s{0,3}(`{3,}|~{3,})", line)
        if marker and not fence:
            fence = marker[1]
            lines.append("\n")
        elif fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence):
                fence = ""
            lines.append("\n")
        else:
            lines.append(line)
    return "".join(lines)


def markdown_anchors(prose: str) -> set[str]:
    anchors = set(re.findall(r'<[^>]+\b(?:id|name)=["\x27]([^"\x27]+)', prose))
    used: set[str] = set()
    for heading in re.findall(r"^ {0,3}#{1,6}\s+(.+?)\s*#*\s*$", prose, re.M):
        heading = re.sub(r"<[^>]*>", "", heading)
        heading = re.sub(r"!?\[([^]]+)\]\([^)]+\)", r"\1", heading)
        slug = re.sub(r"[^\w\- ]", "", heading.lower()).replace(" ", "-")
        candidate, suffix = slug, 0
        while candidate in used:
            suffix += 1
            candidate = f"{slug}-{suffix}"
        used.add(candidate)
        anchors.add(candidate)
    return anchors


def markdown_errors() -> list[str]:
    errors: list[str] = []
    link_re = re.compile(r'!?\[[^]]*\]\(\s*(<[^>]+>|[^\s)]+)(?:\s+"[^"]*")?\s*\)')
    ref_re = re.compile(r"^ {0,3}\[[^]]+\]:\s*(<[^>]+>|\S+)", re.M)
    html_re = re.compile(r'<[^>]+\b(?:src|href)=["\x27]([^"\x27]+)')
    sources = [*sorted(ROOT.glob("*.md")), *sorted((ROOT / "docs").rglob("*.md")),
               ROOT / "libraries/EspressoScaleBLE/README.md", ROOT / "src/safety/README.md"]
    anchor_cache: dict[Path, set[str]] = {}
    for source in sources:
        if source.relative_to(ROOT).parts[:2] in {("docs", "plans"), ("docs", "audits")}:
            continue
        if not source.exists():
            continue
        prose = markdown_prose(source)
        for match in [*link_re.finditer(prose), *ref_re.finditer(prose), *html_re.finditer(prose)]:
            raw = match[1].strip("<>")
            url = urlsplit(raw)
            if url.scheme or url.netloc:
                continue
            target = (source.parent / unquote(url.path)).resolve() if url.path else source.resolve()
            where = f"{source.relative_to(ROOT)}:{prose.count(chr(10), 0, match.start()) + 1}"
            if not target.exists():
                errors.append(f"{where}: missing {raw}")
            elif url.fragment and target.suffix.lower() == ".md":
                if target not in anchor_cache:
                    anchor_cache[target] = markdown_anchors(markdown_prose(target))
                if unquote(url.fragment) not in anchor_cache[target]:
                    errors.append(f"{where}: missing anchor {raw}")
    for _, paths in AREAS.values():
        for path in paths:
            if not (ROOT / path).exists():
                errors.append(f"context map: missing {path}")
    return errors


def require(commands: list[str]) -> list[str]:
    return [command for command in commands if shutil.which(command) is None]


def extract_option(args: list[str], option: str) -> tuple[str | None, list[str]]:
    value = None
    output: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == option:
            if index + 1 >= len(args):
                raise ValueError(f"{option} requires a value")
            value, index = args[index + 1], index + 2
        elif arg.startswith(option + "="):
            value, index = arg.split("=", 1)[1], index + 1
        else:
            output.append(arg)
            index += 1
    return value, output


def safe_args(args: list[str]) -> list[str]:
    result, hide_next = [], False
    for arg in args:
        if hide_next:
            result.append("[REDACTED]")
            hide_next = False
        elif arg in {"--password", "--token", "-t"}:
            result.append(arg)
            hide_next = True
        else:
            result.append(redact(arg))
    return result


def write_summary(command: list[str], risk: str, status: str, started: float,
                  checks: list[dict[str, str]], log_path: Path,
                  manual: list[str], inputs: dict[str, object]) -> Path:
    summary = {
        "schemaVersion": 1,
        "command": safe_args(command),
        "risk": risk,
        "status": status,
        "sha": sha(),
        "inputs": inputs,
        "durationSeconds": round(time.monotonic() - started, 3),
        "checks": checks,
        "logs": [str(log_path.relative_to(ROOT))],
        "artifacts": [],
        "manualValidationsPending": manual,
    }
    summary_path = log_path.parent / "summary.json"
    encoded = json.dumps(summary, indent=2, sort_keys=True) + "\n"
    summary_path.write_text(encoded)
    (ROOT / "artifacts/runs/latest.json").write_text(encoded)
    return summary_path


def execute(command: list[str], risk: str, steps: list[tuple[str, list[str]]],
            verbosity: str, manual: list[str] | None = None,
            prelude: list[str] | None = None, interactive: bool = False,
            env_extra: dict[str, str] | None = None) -> int:
    started = time.monotonic()
    run_id = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + f"-{os.getpid()}"
    run_dir = ROOT / "artifacts/runs" / run_id
    run_dir.mkdir(parents=True, exist_ok=False)
    log_path = run_dir / "run.log"
    lines = list(prelude or [])
    checks: list[dict[str, str]] = []
    code = 0
    with log_path.open("w") as log:
        for initial in lines:
            log.write(redact(initial) + "\n")
        for name, argv in steps:
            marker = f"==> {name}: {' '.join(safe_args(argv))}"
            log.write(marker + "\n")
            if verbosity != "compact":
                print(painted(marker), flush=True)
            child_env = {**os.environ, **(env_extra or {})}
            if interactive:
                child_env.pop("SHOTSTOPPER_NONINTERACTIVE", None)
            else:
                child_env["SHOTSTOPPER_NONINTERACTIVE"] = "1"
            process = subprocess.Popen(argv, cwd=ROOT, text=True,
                                       stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT,
                                       env=child_env)
            assert process.stdout is not None
            for raw in process.stdout:
                clean = redact(raw.rstrip("\n"))
                log.write(clean + "\n")
                lines.append(clean)
                if verbosity != "compact":
                    print(painted(clean), flush=True)
            child_code = process.wait()
            checks.append({"name": name, "status": "passed" if child_code == 0 else "failed"})
            if child_code:
                code = child_code if child_code in {2, 127} else 1
                break
    status = "passed" if code == 0 else ("missing_dependency" if code == 127 else "failed")
    summary = write_summary(command, risk, status, started, checks, log_path,
                            manual or [], {"verbosity": verbosity})
    if verbosity == "compact":
        limit = 20 if code == 0 else 80
        shown = lines[-max(0, limit - 3):]
        headline = f"{status.upper()}: {' '.join(safe_args(command))}"
        print(painted(headline))
        if code:
            print(painted(failed_check_line(checks, lines, status)))
        for line in shown:
            print(painted(line) if len(line) <= 500 else line[:500] + " …[truncated; see full log]")
        print(painted(f"summary: {summary.relative_to(ROOT)}"))
    else:
        print(painted(f"{status}: summary {summary.relative_to(ROOT)}"))
    return code


def record(command: list[str], risk: str, verbosity: str, lines: list[str],
           code: int = 0, check: str = "contract") -> int:
    if code == 127:
        step = [check, ["sh", "-c", "exit 127"]]
    else:
        step = [check, ["sh", "-c", "exit 0" if code == 0 else "exit 1"]]
    return execute(command, risk, [step], verbosity, prelude=lines)


def failed_check_line(checks: list[dict[str, str]], lines: list[str],
                      status: str) -> str:
    """Compact-mode hint: the failed check plus the likeliest cause, drawn
    from the same captured output the run summary records."""
    failed = next((c["name"] for c in reversed(checks)
                   if c["status"] != "passed"), "unknown")
    start = next((i for i, line in enumerate(lines)
                  if line.startswith(f"==> {failed}:")), None)
    output = lines[start + 1:] if start is not None else []
    why = next((line for line in output if re.search(r"\berror\b", line, re.I)),
               None)
    if why is None:
        why = next((line for line in output
                    if re.search(r"\((Failed|Timeout|Not Run)\)$", line)), None)
    if why is None:
        why = next((line for line in output if line.startswith("FAILED:")), None)
    if why is None:
        why = next((line for line in output if line.strip()), None)
    if why is None and status != "missing_dependency":
        why = next((line for line in reversed(lines)
                    if line.strip() and not line.startswith("==>")), None)
    if status == "missing_dependency":
        why = (next((line for line in lines if ": MISSING" in line), None)
               or why or "a required dependency was not found")
    if why and len(why) > 300:
        why = why[:300] + " …[see full log]"
    return f"failed check: {failed} — {why or 'no output captured'}"


def ensure_no_secret_argv(args: list[str]) -> None:
    if any(a in {"--password", "--token", "-t"} or
           a.startswith(("--password=", "--token=")) for a in args):
        raise ValueError(
            "use the hidden prompt, SHOTSTOPPER_DEVICE_PASSWORD, or --password-stdin; never argv")


def extract_switch(args: list[str], option: str) -> tuple[bool, list[str]]:
    if any(arg.startswith(option + "=") for arg in args):
        raise ValueError(f"{option} does not take a value")
    count = args.count(option)
    if count > 1:
        raise ValueError(f"{option} may be passed only once")
    return count == 1, [arg for arg in args if arg != option]


def firmware_pipeline(verb: str, args: list[str]) -> tuple[tuple[str, ...], list[str]]:
    stages = [verb]
    while args and args[0] in FIRMWARE_STAGES:
        stages.append(args.pop(0))
    pipeline = tuple(stages)
    if pipeline not in FIRMWARE_PIPELINES:
        raise ValueError("invalid firmware sequence: " + " ".join(pipeline))
    if any(arg in FIRMWARE_STAGES for arg in args):
        raise ValueError("firmware stages must appear before all options")
    return pipeline, args


def validate_firmware_options(stages: tuple[str, ...], args: list[str]) -> None:
    selected = set(stages)
    applicability = {
        "--port": {"flash", "monitor"}, "-p": {"flash", "monitor"},
        "--speed": {"monitor"}, "-s": {"monitor"},
        "--host": {"ota"}, "-H": {"ota"},
        "--flags": {"build"}, "-f": {"build"},
        "--jtag": {"build"}, "--release": {"build"},
        "--development": {"build"}, "--no-auth-admin": {"build"},
        "--o0": {"build"}, "--og": {"build"}, "--o2": {"build"}, "--os": {"build"},
        "--image": {"flash", "ota"}, "-i": {"flash", "ota"},
        "--webui-language": {"build"},
        "--no-check": {"flash"}, "--erase-all": {"flash"},
        "--discard-ota-session": {"ota"}, "--yes": {"ota"},
        "--wait-for-confirmation": {"ota"},
        "--build-dir": set(), "-b": set(), "--output-dir": set(), "-o": set(),
    }
    for arg in args:
        option = arg.split("=", 1)[0]
        if option == "--force":
            raise ValueError(
                "--force was removed; use --yes and/or --wait-for-confirmation")
        applies = applicability.get(option)
        if applies is not None and not selected.intersection(applies):
            raise ValueError(f"{option} does not apply to {' '.join(stages)}")
    if "build" in selected and any(
            arg in {"--image", "-i"} or arg.startswith("--image=") for arg in args):
        raise ValueError("--image cannot be combined with build; the built artifact is used")


def cmake_steps(preset: str, label: str | None = None) -> list[tuple[str, list[str]]]:
    tests = ["ctest", "--preset", preset]
    if label:
        tests += ["-L", label]
    return [
        (f"configure-{preset}", ["cmake", "--preset", preset]),
        (f"build-{preset}", ["cmake", "--build", "--preset", preset]),
        (f"test-{preset}", tests),
    ]


def help_text() -> str:
    return """usage: ./scripts/dev [--verbosity compact|normal|verbose] COMMAND [ARGS]

commands:
  doctor                     report local tools and the ESP-IDF environment; never installs
  context AREA               list focused paths and their purpose
  classify [PATH ...]        print path risks and aggregate risk
  test [normal|asan|tsan|web|ble|ota|tooling]
  validate [--risk R0..R3] [--webui-language CODE] [PATH ...]
  profiles                   list exact profile IDs and compatibility
  build [flash|ota] [monitor] [ARGS]
  flash|ota [monitor] [ARGS] run one or more ordered firmware stages
  monitor [ARGS]             open only the serial monitor
  analyze [ARGS]             run supported IDF static analysis
  clean --dry-run            list generated directories; --confirm removes them

Verbosity is independent of firmware runtime logging. Default is normal on a
TTY and compact otherwise; SHOTSTOPPER_VERBOSITY provides the environment default.
"""


def firmware_help() -> str:
    return """usage: ./scripts/dev build [flash|ota] [monitor] [OPTIONS]
       ./scripts/dev flash|ota [monitor] [OPTIONS]
       ./scripts/dev monitor [OPTIONS]

Valid sequences: build; flash; ota; monitor; build flash; build ota;
flash monitor; ota monitor; build flash monitor; build ota monitor.

Profiles: --hardware ID --machine ID
Existing images: --arch ARCH; standalone flash/OTA: --image PATH
Build:  --flags STRING --development | --release (default)
        --no-auth-admin --jtag --webui-language CODE
        --o0 --og --o2 --os (exclusive firmware optimization level)
Flash:  --port PATH --no-check --erase-all
OTA:    --host HOST --yes --wait-for-confirmation --discard-ota-session
Monitor: --port PATH --speed BAUD

Flash and OTA require --confirm. OTA credentials come from the hidden prompt,
SHOTSTOPPER_DEVICE_PASSWORD, or --password-stdin; password values are never argv.
Options follow the complete stage sequence.
"""


def main() -> int:
    raw = sys.argv[1:]
    try:
        verbosity, raw = extract_option(raw, "--verbosity")
        verbosity = verbosity or os.getenv("SHOTSTOPPER_VERBOSITY") or (
            "normal" if sys.stdout.isatty() else "compact")
        if verbosity not in {"compact", "normal", "verbose"}:
            raise ValueError("verbosity must be compact, normal, or verbose")
        if not raw or raw[0] in {"help", "-h", "--help"}:
            print(help_text())
            return 0
        verb, args = raw[0], raw[1:]
        command = ["./scripts/dev", verb, *args]

        if verb == "doctor":
            if args:
                raise ValueError("doctor takes no arguments")
            tools = ["git", "python3", "cmake", "ctest", "c++", "node", "npm", "cppcheck"]
            lines = [f"{tool}: {shutil.which(tool) or 'MISSING'}" for tool in tools]
            missing = require(tools[:5])
            probe = subprocess.run(
                ["bash", "-c",
                 'source scripts/shotstopper_board.sh; '
                 'source scripts/shotstopper_cli.sh; '
                 'source scripts/shotstopper_idf.sh; ss_idf_environment_report'],
                cwd=ROOT, text=True, capture_output=True)
            report = dict(field.split("=", 1)
                          for field in probe.stdout.splitlines() if "=" in field)
            idf_path = report.get("IDF_PATH")
            venv = report.get("IDF_PYTHON_ENV_PATH")
            venv_source = report.get("venv_source", "")
            mismatch = report.get("venv_mismatch") == "yes"
            if idf_path is None:
                lines.append("ESP-IDF: not found; install 6.1.x per docs/BUILD.md")
            else:
                if venv_source == "active":
                    detail = f"active environment: {venv}"
                elif venv:
                    detail = f"auto-selected installed venv: {venv}"
                elif mismatch:
                    detail = "export.sh venv is missing; builds self-heal at activation"
                else:
                    detail = "resolved by export.sh at build time"
                lines.append("ESP-IDF: " + idf_path +
                             (" (venv mismatch)" if mismatch else ""))
                lines.append(f"IDF Python environment: {detail}")
            return record(command, "R0", verbosity, lines, 127 if missing else 0, "doctor")

        if verb == "context":
            if len(args) != 1 or args[0] not in AREAS:
                raise ValueError("context area must be one of: " + ", ".join(AREAS))
            description, paths = AREAS[args[0]]
            lines = [f"{args[0]} — {description}", *paths]
            return record(command, "R0", verbosity, lines, 0, "context-paths")

        if verb == "classify":
            risk, details = classify(args)
            lines = [*(f"{item_risk} {path}" for path, item_risk in details),
                     *(f"warning: changed path outside requested scope: {p}"
                       for p in uncovered_changes(args)),
                     f"risk={risk}"]
            return record(command, risk, verbosity, lines, 0, "risk-classification")

        if verb == "profiles":
            if args:
                raise ValueError("profiles takes no arguments")
            return execute(command, "R0", [("profiles", [
                "python3", "scripts/resolve_build_profiles.py", "--list"])], verbosity)

        if verb == "test":
            profile = args[0] if args else "normal"
            if len(args) > 1:
                raise ValueError("test accepts one profile")
            missing = require(["cmake", "ctest", "c++"])
            if missing:
                return record(command, "R1", verbosity,
                              ["missing: " + ", ".join(missing)], 127, profile)
            if profile == "normal":
                steps = cmake_steps("normal")
            elif profile == "asan":
                steps = cmake_steps("asan-ubsan")
            elif profile == "tsan":
                steps = cmake_steps("tsan")
            elif profile == "ble":
                steps = cmake_steps("normal", "ble")
            elif profile == "ota":
                return record(command, "R1", verbosity,
                              ["OTA is disabled; firmware installation is USB-only"],
                              0, "ota-disabled")
            elif profile == "web":
                deps = [ROOT / "node_modules" / name for name in
                        ["terser", "html-minifier-terser", "clean-css", "@gfx/zopfli"]]
                if require(["node"]) or any(not dep.exists() for dep in deps):
                    return record(command, "R1", verbosity,
                                  ["Web dependencies missing; run npm ci explicitly"], 127, "web")
                steps = [HTTP_ROUTE_CAPACITY_STEP,
                         ("web-contracts", ["node", "src/tests/check_web_assets.js"])]
            elif profile == "tooling":
                steps = [("tooling-contracts", ["python3", "src/tests/dev_tooling_test.py"]),
                         ("build-profiles", ["python3", "src/tests/build_profiles_test.py"])]
            else:
                raise ValueError("unknown test profile: " + profile)
            return execute(command, "R2" if profile in {"ble", "ota"} else "R1",
                           steps, verbosity)

        if verb == "validate":
            override, paths = extract_option(args, "--risk")
            webui_language, paths = extract_option(paths, "--webui-language")
            webui_language = (webui_language or
                              os.getenv("SHOTSTOPPER_WEBUI_LANGUAGE") or "en")
            webui_language = webui_language.strip().replace("_", "-").lower()
            if not re.fullmatch(r"[a-z]{2,3}(?:-[a-z0-9]{2,8})*", webui_language):
                raise ValueError("invalid WebUI language code")
            inferred, details = classify(paths)
            if override not in RANK:
                if override is not None:
                    raise ValueError("risk must be R0, R1, R2, or R3")
                risk = inferred
            else:
                if RANK[override] < RANK[inferred]:
                    raise ValueError(f"risk override cannot lower {inferred} to {override}")
                risk = override
            doc_errors = markdown_errors()
            prelude = [*(f"{r} {p}" for p, r in details),
                       *(f"warning: changed path outside requested scope: {p}"
                         for p in uncovered_changes(paths)),
                       f"risk={risk}"]
            if doc_errors:
                return record(command, risk, verbosity, doc_errors, 1, "docs-and-paths")
            if risk == "R0":
                return record(command, risk, verbosity, prelude + ["documentation links and context paths: OK"])
            steps = cmake_steps("normal")
            if risk in {"R2", "R3"}:
                steps += cmake_steps("asan-ubsan") + cmake_steps("tsan")
                steps += [HTTP_ROUTE_CAPACITY_STEP,
                          ("architecture", ["python3", "scripts/check_architecture.py"]),
                          ("web-contracts", ["node", "src/tests/check_web_assets.js"])]
                for hardware, machine in BUILD_PROFILES:
                    steps.append((f"idf-{hardware}--{machine}", [
                        "./scripts/internal/build-idf", "--hardware", hardware,
                        "--machine", machine, "--webui-language", webui_language,
                        *FIRMWARE_BUDGET_OPTIONS]))
            if risk == "R3":
                for hardware, machine in BUILD_PROFILES:
                    variant = f"{hardware}--{machine}"
                    steps += [(f"cppcheck-{variant}", ["./scripts/static-idf",
                                "--arch", "n16r8", "--build-dir", f"build-idf/{variant}"]),
                              (f"warnings-{variant}", ["./scripts/warnings-idf",
                                "--hardware", hardware, "--machine", machine,
                                "--webui-language", webui_language,
                                *FIRMWARE_BUDGET_OPTIONS])]
            manual = ["Complete and attach applicable HIL/manual evidence"] if risk == "R3" else []
            return execute(command, risk, steps, verbosity, manual, prelude)

        if verb in FIRMWARE_STAGES:
            ensure_no_secret_argv(args)
            stages, args = firmware_pipeline(verb, args)
            if "ota" in stages:
                raise ValueError("OTA is disabled; install firmware over USB with flash")
            if any(arg in {"-h", "--help", "help"} for arg in args):
                print(help_text() + "\n" + firmware_help())
                return 0
            confirmed, args = extract_switch(args, "--confirm")
            password_stdin, args = extract_switch(args, "--password-stdin")
            validate_firmware_options(stages, args)
            transfer = set(stages).intersection({"flash", "ota"})
            if transfer and not confirmed:
                raise ValueError(
                    f"{'/'.join(sorted(transfer))} requires --confirm; this command can affect hardware")
            if confirmed and not transfer:
                raise ValueError("--confirm applies only to flash or ota")
            if password_stdin and "ota" not in stages:
                raise ValueError("--password-stdin applies only to ota")
            env_extra: dict[str, str] = {}
            if password_stdin:
                password = sys.stdin.readline().rstrip("\r\n")
                if not password:
                    raise ValueError("--password-stdin received an empty password")
                env_extra["SHOTSTOPPER_DEVICE_PASSWORD"] = password
            risk = "R3" if "flash" in stages else (
                "R2" if set(stages).intersection({"build", "ota"}) else "R1")
            step_name = "firmware-" + "-".join(stages)
            return execute(
                command, risk,
                [(step_name, ["./scripts/internal/firmware-idf", *stages, "--", *args])],
                verbosity,
                ["Verify physical safety before hardware use"] if transfer else [],
                interactive=sys.stdin.isatty(), env_extra=env_extra)

        if verb == "analyze":
            ensure_no_secret_argv(args)
            return execute(command, "R2", [(verb, ["./scripts/static-idf", *args])],
                           verbosity)

        if verb == "clean":
            targets = [ROOT / "build-host", ROOT / "artifacts/runs"]
            if args == ["--dry-run"]:
                return record(command, "R1", verbosity,
                              [str(path.relative_to(ROOT)) for path in targets], 0, "clean-dry-run")
            if args != ["--confirm"]:
                raise ValueError("clean requires --dry-run or --confirm")
            for target in targets:
                if target.exists():
                    shutil.rmtree(target)
            print("removed: " + ", ".join(str(path.relative_to(ROOT)) for path in targets))
            return 0

        raise ValueError("unknown command: " + verb)
    except ValueError as error:
        print(painted(f"dev: {error}"), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())

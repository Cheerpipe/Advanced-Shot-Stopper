#!/usr/bin/env bash
# Build and flash Shot Stopper (ESP-IDF) in one command.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

usage() {
  cat <<EOF
Usage: ./scripts/bf-idf [flags]

Runs, in order: build-idf and flash-idf. The flash step skips the local image
re-check and transfers the output that build-idf just produced.

Required parameters: --port, --hardware, and --machine. --flags is optional.

$(ss_flag_help)

Examples:
  ./scripts/bf-idf --port /dev/cu.usbmodem2101 \
    --hardware esp32-s3-relay-x1-speaker --machine rancilio-silvia-pro-x
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

# Resolve everything once here so the child scripts never prompt again.
ss_cli_resolve "port hardware_config machine_config webui_language" "flags" || exit $?
ss_cli_normalize_image || exit $?

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

ss_cli_flags_for hardware_config machine_config flags webui_language development
./scripts/build-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}

ss_cli_flags_for port hardware_config machine_config image no_check erase_all
exec ./scripts/flash-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}
